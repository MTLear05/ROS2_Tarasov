<span class="line"></span>
<span class="line"><span style="color: rgb(86, 156, 214);">def</span><span style="color: rgb(220, 220, 170);"> main</span><span style="color: rgb(230, 230, 230);">(</span><span style="color: rgb(156, 220, 254);">args</span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(86, 156, 214);">None</span><span style="color: rgb(230, 230, 230);">):</span></span>
