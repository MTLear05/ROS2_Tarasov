l_title\":\"\",\"new_imagine_nux_modal_cta\":\"Get Started\",\"region_edit\":true,\"segment\":true,\"segment_home_template\":true,\"precise_edit_home_template\":true},\"imagine-templates-config\":{},\"enable_memory_summary\":false,\"show_privacy_policy_notice\":false,\"enable_gateway_chat_v2\":false,\"enable_attach_menu\":false,\"enable_better_upscale_web\":false,\"subscriptions_cancel_flow_downgrade_step_enabled\":true,\"enable_imagine_paywall\":true,\"chat_v2_rollout\":{\"enabled_internal\":false,\"enabled_external\":false,\"beta_internal\":false,\"beta_external\":false,\"beta_mobile_internal\":false,\"beta_mobile_external\":false},\"enable_imagine_paywall_testimonials\":true,\"enable_imagine_paywall_gallery_carousel\":true,\"web_enable_payment_lapsed_banner\":{\"enable\":false},\"web_payment_lapsed_banner\":{\"enabled\":false},\"web_response_throttle_banner\":{\"dismissable\":true},\"enable_imagine_template_x_handle\":true,\"import_memory_prompt\":\"$61\",\"enable_memory_import\":true,\"query_bar_accessibility\":{\"enabled\":true,\"text\":\"Agent (Beta)\",\"dynamic_pills\":[{\"icon\":\"photo-stack\",\"prompts\":[{\"label\":\"Create Worlds\",\"prompt\":\"First, generate 6 world concepts and their infographics. Then show a scene from each world.\"},{\"label\":\"Character Sheets\",\"prompt\":\"First, create 6 character sheets in landscape. Then edit each sheet to get a portrait model of each character.\"}]},{\"icon\":\"film-roll\",\"prompts\":[{\"label\":\"Short Film\",\"prompt\":\"Give me 3 quick ideas for a 1 minute film. Then, generate an image of the main character in each film. Then use that image to create a movie poster for each film.\"},{\"label\":\"Manga One-Shot\",\"prompt\":\"Give me 3 quick ideas for a short manga one-shot. For each, generate the main character, then create a sequence of manga panels for a key scene.\"}]},{\"icon\":\"camera\",\"prompts\":[{\"label\":\"UGC Product Stories\",\"prompt\":\"Generate 3 distinct products and 3 diverse realistic everyday models. First, create reference images of each product and natural lifestyle portraits for each model. Then develop 3 UGC concept stories mixing the products and models. For each story, generate candid user-style photos or keyframes of the model using the product, then use those images to create complete social media packs (carousels, Stories, Reels covers, and posts).\"},{\"label\":\"UGC Scenes\",\"prompt\":\"Generate 3 authentic UGC-style product-in-use scene concepts showing everyday people with the product. For each, first create candid, natural-looking user photos from different angles, then use the strongest images to build complete ready-to-post Instagram/TikTok carousels, Reels covers, and story templates\"}]},{\"icon\":\"layout\",\"prompts\":[{\"label\":\"Brand Identity\",\"prompt\":\"Create 2 distinct brand identity directions for a product or company. For each direction, first generate core visual assets as high-quality images (logo variations, color palette, typography samples), then use those generated images to produce realistic application mockups on business cards, website headers, packaging, and marketing materials.\"},{\"label\":\"Cover Concepts\",\"prompt\":\"Create 4 different cover concepts for a report, ebook, whitepaper, or book. Then produce full mockups showing the cover in 3D and in-context usage.\"}]}]},\"enable_imagine_multi_ref_edit_template\":false,\"supergrok_paywall_free_trial_zero_price\":false,\"supergrok_upsells_free_trial_zero_price\":false,\"enable_imagine_lightbox_view_tabs\":false,\"disable_report_issue\":false,\"disable_conversation_search\":false,\"enable_chat_image_make_video\":false,\"can_access_collections\":true,\"hide_files_page\":false,\"can_access_team_settings\":true,\"enable_imagine_post_nav\":true,\"enable_imagine_in_app_auth\":false,\"enable_file_mentions\":false,\"enable_imagine_template_featuring_opt_in\":true,\"enable_update_payment_method_in_settings\":false,\"enable_atlas_type_to_prompt\":true,\"show