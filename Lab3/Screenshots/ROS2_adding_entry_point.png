<span class="line"><span style="color: rgb(230, 230, 230);">            (</span><span style="color: rgb(181, 206, 168);">0.0</span><span style="color: rgb(230, 230, 230);">, </span><span style="color: rgb(86, 156, 214);">self</span><span style="color: rgb(230, 230, 230);">.ros_node.angular_speed): </span><span style="color: rgb(206, 145, 120);">'Ліворуч'</span><span style="color: rgb(230, 230, 230);">,</span></span>
