: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; padding: 0px 16px 16px; margin-top: 0px; font-size: 0.9em; font-family: var(--font-ibm-plex-mono); line-height: 1.5em; background-color: var(--surface-inset); color: var(--fg-primary); display: block; overflow: auto;"><pre class="shiki slack-dark" tabindex="0" role="group" aria-label="Python code" style="background-color: rgb(34, 34, 34); color: rgb(230, 230, 230);"><code><span class="line"><span style="color: rgb(106, 153, 85);">#!/usr/bin/env python3</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">import</span><span style="color: rgb(230, 230, 230);"> sys</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">import</span><span style="color: rgb(230, 230, 230);"> rclpy</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">from</span><span style="color: rgb(230, 230, 230);"> rclpy.node </span><span style="color: rgb(197, 134, 192);">import</span><span style="color: rgb(230, 230, 230);"> Node</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">from</span><span style="color: rgb(230, 230, 230);"> geometry_msgs.msg </span><span style="color: rgb(197, 134, 192);">import</span><span style="color: rgb(230, 230, 230);"> Twist</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">from</span><span style="color: rgb(230, 230, 230);"> std_msgs.msg </span><span style="color: rgb(197, 134, 192);">import</span><span style="color: rgb(230, 230, 230);"> String</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(197, 134, 192);">from</span><span style="color: rgb(230, 230, 230);"> PyQt5.QtWidgets </span><span style="color: rgb(197, 134, 192);">import</span><span style="color: rgb(230, 230, 230);"> (</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    QApplication, QWidget, QPushButton, QVBoxLayout,</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    QHBoxLayout, QLabel, QGridLayout</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">)</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">from</span><span style="color: rgb(230, 230, 230);"> PyQt5.QtCore </span><span style="color: rgb(197, 134, 192);">import</span><span style="color: rgb(230, 230, 230);"> QTimer</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">from</span><span style="color: rgb(230, 230, 230);"> PyQt5.QtGui </span><span style="color: rgb(197, 134, 192);">import</span><span style="color: rgb(230, 230, 230);"> QFont</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(86, 156, 214);">class</span><span style="color: rgb(78, 201, 176);"> RobotGUI</span><span style="color: rgb(230, 230, 230);">(</span><span style="color: rgb(78, 201, 176);">Node</span><span style="color: rgb(230, 230, 230);">):</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    def</span><span style="color: rgb(220, 220, 170);"> __init__</span><span style="color: rgb(230, 230, 230);">(</span><span style="color: rgb(156, 220, 254);">self</span><span style="color: rgb(230, 230, 230);">):</span></span>
<span class="line"><span style="color: rgb(78, 201, 176);">        super</span><span style="color: rgb(230, 230, 230);">().</span><span style="color: rgb(220, 220, 170);">__init__</span><span style="color: rgb(230, 230, 230);">(</span><span style="color: rgb(206, 145, 120);">'robot_gui_node'</span><span style="color: rgb(230, 230, 230);">)</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">        # Publisher на /cmd_vel</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">        self</span><span style="color: rgb(230, 230, 230);">.publisher_ </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(86, 156, 214);"> self</span><span style="color: rgb(230, 230, 230);">.create_publisher(Twist, </span><span style="color: rgb(206, 145, 120);">'/cmd_vel'</span><span style="color: rgb(230, 230, 230);">, </span><span style="color: rgb(181, 206, 168);">10</span><span style="color: rgb(230, 230, 230);">)</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">        # Підписка на статус (якщо Motion Node публікує)</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">        self</span><span style="color: rgb(230, 230, 230);">.status_sub </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(86, 156, 214);"> self</span><span style="color: rgb(230, 230, 230);">.create_subscription(</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">            String,</span></span>
<span class="line"><span style="color: rgb(206, 145, 120);">            '/motion_status'</span><span style="color: rgb(230, 230, 230);">,</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">            self</span><span style="color: rgb(230, 230, 230);">.status_callback,</span></span>
<span class="line"><span style="color: rgb(181, 206, 168);">            10</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        )</span></span>
<span class="line"></span>
