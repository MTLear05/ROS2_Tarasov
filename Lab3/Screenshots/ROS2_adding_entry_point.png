<span class="line"><span style="color: rgb(78, 201, 176);">        super</span><span style="color: rgb(230, 230, 230);">().</span><span style="color: rgb(220, 220, 170);">__init__</span><span style="color: rgb(230, 230, 230);">(</span><span style="color: rgb(206, 145, 120);">'motion_node'</span><span style="color: rgb(230, 230, 230);">)</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">        # Максимальні допустимі швидкості</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">        self</span><span style="color: rgb(230, 230, 230);">.max_linear </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(181, 206, 168);"> 1.0</span><span style="color: rgb(106, 153, 85);">      # м/с</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">        self</span><span style="color: rgb(230, 230, 230);">.max_angular </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(181, 206, 168);"> 1.5</span><span style="color: rgb(106, 153, 85);">     # рад/с</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">        # Підписка на /cmd_vel</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">        self</span><span style="color: rgb(230, 230, 230);">.subscription </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(86, 156, 214);"> self</span><span style="color: rgb(230, 230, 230);">.create_subscription(</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">            Twist,</span></span>
<span class="line"><span style="color: rgb(206, 145, 120);">            '/cmd_vel'</span><span style="color: rgb(230, 230, 230);">,</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">            self</span><span style="color: rgb(230, 230, 230);">.cmd_vel_callback,</span></span>
<span class="line"><span style="color: rgb(181, 206, 168);">            10</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        )</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(86, 156, 214);">        self</span><span style="color: rgb(230, 230, 230);">.get_logger().info(</span><span style="color: rgb(206, 145, 120);">'Motion Node запущено. Чекаю команди на /cmd_vel...'</span><span style="color: rgb(230, 230, 230);">)</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    def</span><span style="color: rgb(220, 220, 170);"> cmd_vel_callback</span><span style="color: rgb(230, 230, 230);">(</span><span style="color: rgb(156, 220, 254);">self</span><span style="color: rgb(230, 230, 230);">, </span><span style="color: rgb(156, 220, 254);">msg</span><span style="color: rgb(230, 230, 230);">: Twist):</span></span>
<span class="line"><span style="color: rgb(106, 153, 85);">        # Отримуємо значення</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        linear_x </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(230, 230, 230);"> msg.linear.x</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        angular_z </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(230, 230, 230);"> msg.angular.z</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">        # Обмеження швидкості</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        limited </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(86, 156, 214);"> False</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(197, 134, 192);">        if</span><span style="color: rgb(220, 220, 170);"> abs</span><span style="color: rgb(230, 230, 230);">(linear_x) </span><span style="color: rgb(212, 212, 212);">&gt;</span><span style="color: rgb(86, 156, 214);"> self</span><span style="color: rgb(230, 230, 230);">.max_linear:</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">            linear_x </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(86, 156, 214);"> self</span><span style="color: rgb(230, 230, 230);">.max_linear </span><span style="color: rgb(197, 134, 192);">if</span><span style="color: rgb(230, 230, 230);"> linear_x </span><span style="color: rgb(212, 212, 212);">&gt;</span><span style="color: rgb(181, 206, 168);"> 0</span><span style="color: rgb(197, 134, 192);"> else</span><span style="color: rgb(212, 212, 212);"> -</span><span style="color: rgb(86, 156, 214);">self</span><span style="color: rgb(230, 230, 230);">.max_linear</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">            limited </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(86, 156, 214);"> True</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(197, 134, 192);">        if</span><span style="color: rgb(220, 220, 170);"> abs</span><span style="color: rgb(230, 230, 230);">(angular_z) </span><span style="color: rgb(212, 212, 212);">&gt;</span><span style="color: rgb(86, 156, 214);"> self</span><span style="color: rgb(230, 230, 230);">.max_angular:</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">            angular_z </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(86, 156, 214);"> self</span><span style="color: rgb(230, 230, 230);">.max_angular </span><span style="color: rgb(197, 134, 192);">if</span><span style="color: rgb(230, 230, 230);"> angular_z </span><span style="color: rgb(212, 212, 212);">&gt;</span><span style="color: rgb(181, 206, 168);"> 0</span><span style="color: rgb(197, 134, 192);"> else</span><span style="color: rgb(212, 212, 212);"> -</span><span style="color: rgb(86, 156, 214);">self</span><span style="color: rgb(230, 230, 230);">.max_angular</span></span>
