<span class="line"><span style="color: rgb(230, 230, 230);">            (</span><span style="color: rgb(181, 206, 168);">0.0</span><span style="color: rgb(230, 230, 230);">, </span><span style="color: rgb(181, 206, 168);">0.0</span><span style="color: rgb(230, 230, 230);">): </span><span style="color: rgb(206, 145, 120);">'СТОП'</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">        }</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">        self</span><span style="color: rgb(230, 230, 230);">.status_label.setText(</span><span style="color: rgb(86, 156, 214);">f</span><span style="color: rgb(206, 145, 120);">'Статус: Відправлено команду → </span><span style="color: rgb(86, 156, 214);">{</span><span style="color: rgb(230, 230, 230);">direction.get((linear, angular), </span><span style="color: rgb(206, 145, 120);">"Невідомо"</span><span style="color: rgb(230, 230, 230);">)</span><span style="color: rgb(86, 156, 214);">}</span><span style="color: rgb(206, 145, 120);">'</span><span style="color: rgb(230, 230, 230);">)</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(86, 156, 214);">    def</span><span style="color: rgb(220, 220, 170);"> update_status</span><span style="color: rgb(230, 230, 230);">(</span><span style="color: rgb(156, 220, 254);">self</span><span style="color: rgb(230, 230, 230);">):</span></span>
<span class="line"><span style="color: rgb(106, 153, 85);">        # Оновлюємо статус з ROS-топіка (якщо є)</span></span>
<span class="line"><span style="color: rgb(197, 134, 192);">        if</span><span style="color: rgb(86, 156, 214);"> self</span><span style="color: rgb(230, 230, 230);">.ros_node.current_status </span><span style="color: rgb(212, 212, 212);">!=</span><span style="color: rgb(206, 145, 120);"> "Очікування команди..."</span><span style="color: rgb(230, 230, 230);">:</span></span>
<span class="line"><span style="color: rgb(86, 156, 214);">            self</span><span style="color: rgb(230, 230, 230);">.status_label.setText(</span><span style="color: rgb(86, 156, 214);">f</span><span style="color: rgb(206, 145, 120);">'Статус: </span><span style="color: rgb(86, 156, 214);">{self</span><span style="color: rgb(230, 230, 230);">.ros_node.current_status</span><span style="color: rgb(86, 156, 214);">}</span><span style="color: rgb(206, 145, 120);">'</span><span style="color: rgb(230, 230, 230);">)</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(86, 156, 214);">def</span><span style="color: rgb(220, 220, 170);"> main</span><span style="color: rgb(230, 230, 230);">(</span><span style="color: rgb(156, 220, 254);">args</span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(86, 156, 214);">None</span><span style="color: rgb(230, 230, 230);">):</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    rclpy.init(</span><span style="color: rgb(156, 220, 254);">args</span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(230, 230, 230);">args)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    ros_node </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(230, 230, 230);"> RobotGUI()</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    app </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(230, 230, 230);"> QApplication(sys.argv)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    window </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(230, 230, 230);"> MainWindow(ros_node)</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    window.show()</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(106, 153, 85);">    # Інтеграція ROS spin з Qt</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    timer </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(230, 230, 230);"> QTimer()</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    timer.timeout.connect(</span><span style="color: rgb(86, 156, 214);">lambda</span><span style="color: rgb(230, 230, 230);">: rclpy.spin_once(ros_node, </span><span style="color: rgb(156, 220, 254);">timeout_sec</span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(181, 206, 168);">0</span><span style="color: rgb(230, 230, 230);">))</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    timer.start(</span><span style="color: rgb(181, 206, 168);">20</span><span style="color: rgb(230, 230, 230);">)</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    exit_code </span><span style="color: rgb(212, 212, 212);">=</span><span style="color: rgb(230, 230, 230);"> app.exec_()</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    ros_node.destroy_node()</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    rclpy.shutdown()</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    sys.exit(exit_code)</span></span>
<span class="line"></span>
<span class="line"><span style="color: rgb(197, 134, 192);">if</span><span style="color: rgb(156, 220, 254);"> __name__</span><span style="color: rgb(212, 212, 212);"> ==</span><span style="color: rgb(206, 145, 120);"> '__main__'</span><span style="color: rgb(230, 230, 230);">:</span></span>
<span class="line"><span style="color: rgb(230, 230, 230);">    main()</span></span></code></pre></div></div></div></div>
