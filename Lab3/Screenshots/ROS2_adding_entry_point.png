<span class="line"></span>
<span class="line"><span style="color: rgb(86, 156, 214);">class</span><span style="color: rgb(78, 201, 176);"> MotionNode</span><span style="color: rgb(230, 230, 230);">(</span><span style="color: rgb(78, 201, 176);">Node</span><span style="color: rgb(230, 230, 230);">):</span></span>
